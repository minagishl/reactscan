{
  "name": "reactscan",
  "version": "0.1.0",
  "description": "Non-intrusive CLI to statically inspect React / Next.js projects.",
  "type": "module",
  "bin": {
    "reactscan": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"src/**/*.{ts,tsx,js,json}\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,js,json}\"",
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.7.4",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.48.1"
  }
}
