{
  "name": "@minagishl/reactscan",
  "version": "1.2.2",
  "description": "Non-intrusive CLI to statically inspect React / Next.js projects.",
  "type": "module",
  "bin": {
    "reactscan": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "nextjs",
    "security",
    "cli",
    "static-analysis"
  ],
  "author": "minagishl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/minagishl/reactscan.git"
  },
  "homepage": "https://github.com/minagishl/reactscan#readme",
  "bugs": {
    "url": "https://github.com/minagishl/reactscan/issues"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"src/**/*.{ts,tsx,js,json}\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,js,json}\"",
    "build": "node scripts/build.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.3",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "globby": "^14.0.2",
    "node-html-parser": "^6.1.13",
    "semver": "^7.6.3",
    "undici": "^6.19.8",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "esbuild": "^0.24.0",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.48.1"
  }
}
